{
    "name": "jb/skeleton",
    "description": "Proyecto base para APIs REST con JB Framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "jb/framework": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php scripts/post-install.php"
        ],
        "serve": "php -S 127.0.0.1:8000 -t public",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
